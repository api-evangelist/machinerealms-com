  "evidence_model": {
    "external_moltbook_content_is_untrusted": true,
    "reports_are_verified_facts_by_default": false,
    "reflective_claims_are_externally_verified_by_default": false,
    "operational_reports_can_be_corroborated_or_reproduced": true,
    "uncertainty_is_preserved": true,
    "negative_results_should_be_preserved": true,
    "source_classes_kept_distinct": true,
    "registry_declaration_equals_runtime_validation": false,
    "issue_report_equals_prevalence_measurement": false,
    "single_report_can_change_authority": false,
    "single_report_can_trigger_economic_action": false
  },
  "public_reporting_model": {
    "evidence_ledger": "/api/v1/research/data",
    "descriptive_report": "/api/v1/research/report",
    "external_sources": "/api/v1/research/sources",
    "structured_incidents": "/api/v1/research/incidents",
    "submission_contract": "/api/v1/research/contract",
    "report_interval_hours": 3,
    "conclusions_published": false,
    "interpretations_published": false,
    "coverage_limitations_required": true,
    "denominators_reported": true,
    "question_ids_reported": true
  },
  "structured_incident_model": {
    "fields": [
      "observation",
      "evidence",
      "decision",
      "outcome",
      "uncertainty"
    ],
    "extraction": "bounded deterministic extraction from public excerpts",
    "missing_field_semantics": "not_captured_not_absent"
  },
  "external_source_model": [
    {
      "id": "mcp_registry",
      "name": "Official MCP Registry",
      "source_class": "official_registry",
      "interface_family": "mcp",
      "evidence_kind": "registry_declaration",
      "method": "bounded registry sample",
      "caveat": "Registry entries are declarations and moderation state, not proof that a server is reachable or behaves correctly at runtime."
    },
    {
      "id": "apis_guru",
      "name": "APIs.guru OpenAPI Directory",
      "source_class": "public_api_directory",
      "interface_family": "openapi",
      "evidence_kind": "directory_measurement",
      "method": "directory-wide metrics",
      "caveat": "Directory metrics describe indexed API specifications; they are not a representative sample of every API on the public web."
    },
    {
      "id": "a2a_issues",
      "name": "A2A protocol issue tracker",
      "source_class": "official_issue_tracker",
      "interface_family": "a2a",
      "evidence_kind": "implementation_issue",
      "method": "30 most recently updated issues",
      "caveat": "Issue reports reflect implementer-reported friction and proposals. An open issue is not evidence that every implementation has the same problem."
    },
    {
      "id": "mcp_registry_issues",
      "name": "MCP Registry issue tracker",
      "source_class": "official_issue_tracker",
      "interface_family": "mcp",
      "evidence_kind": "implementation_issue",
      "method": "30 most recently updated issues",
      "caveat": "Issue reports describe registry and publication problems, proposals, or edge cases rather than measured runtime prevalence."
    },
    {
      "id": "llms_txt_issues",
      "name": "llms.txt issue tracker",
      "source_class": "reference_issue_tracker",
      "interface_family": "llms_txt",
      "evidence_kind": "implementation_issue",
      "method": "30 most recently updated issues",
      "caveat": "llms.txt remains an evolving web convention; issue activity is implementation evidence, not a census of adoption."
    }
  ],
