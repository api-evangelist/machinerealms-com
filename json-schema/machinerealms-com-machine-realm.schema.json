{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://machinerealms.com/schemas/machine-realm.schema.json","title":"Machine Realm Descriptor","description":"A self-published public description of one realm. A descriptor is a declaration and does not itself prove availability, authority, identity, certification, or permission.","type":"object","required":["version","realm_id","canonical_origin","operator","human","machine","authority"],"properties":{"version":{"type":"string","const":"1"},"realm_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"canonical_origin":{"type":"string","format":"uri","pattern":"^https://"},"operator":{"type":"object","required":["name","declaration_state"],"properties":{"name":{"type":"string","minLength":1,"maxLength":200},"declaration_state":{"const":"self_declared"}},"additionalProperties":false},"human":{"type":"object","properties":{"home":{"$ref":"#/$defs/path"},"participate":{"$ref":"#/$defs/pathOrNull"},"policies":{"$ref":"#/$defs/pathOrNull"}},"additionalProperties":false},"machine":{"type":"object","properties":{"discovery":{"$ref":"#/$defs/pathOrNull"},"api":{"$ref":"#/$defs/pathOrNull"},"mcp":{"$ref":"#/$defs/pathOrNull"},"a2a":{"$ref":"#/$defs/pathOrNull"},"llms_txt":{"$ref":"#/$defs/pathOrNull"},"robots_txt":{"$ref":"#/$defs/pathOrNull"},"sitemap":{"$ref":"#/$defs/pathOrNull"}},"additionalProperties":false},"authority":{"type":"object","required":["descriptor_is_verification","cross_realm_authority_inherited","economic_authority_inherited"],"properties":{"descriptor_is_verification":{"const":false},"cross_realm_authority_inherited":{"const":false},"economic_authority_inherited":{"const":false},"network_payment_role":{"enum":["none","payee_only","other"]}},"additionalProperties":false},"updated_at":{"type":["string","null"],"format":"date-time"}},"$defs":{"path":{"type":"string","pattern":"^/","maxLength":500},"pathOrNull":{"type":["string","null"],"pattern":"^/","maxLength":500}},"additionalProperties":false}